# Bridge configuration. Copy to `.env` and fill in — `.env` is gitignored and
# must never be committed; this repo is public.
#
#   cp .env.example .env
#
# load_env.py turns each KEY=value below into a -D KEY="value" build flag, so
# these land in the firmware at compile time. Values are taken literally to the
# end of the line: do not quote them, and do not add trailing comments.

WIFI_SSID=YOUR_SSID
WIFI_PASS=YOUR_PASS

# POSIX TZ string. The bridge owns timezone and DST — the device is told local
# time already adjusted and never reasons about zones. See the tzdata POSIX
# format, e.g. GMT0BST,M3.5.0/1,M10.5.0 for the UK.
TZ_POSIX=PST8PDT,M3.2.0,M11.1.0

# NTP server.
NTP1=pool.ntp.org
