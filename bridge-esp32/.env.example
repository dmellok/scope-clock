# Bridge configuration. Copy to `.env` and fill in — `.env` is gitignored and
# must never be committed; this repo is public.
#
#   cp .env.example .env
#
# load_env.py turns each KEY=value below into a -D KEY="value" build flag, so
# these land in the firmware at compile time. Values are taken literally to the
# end of the line: do not quote them, and do not add trailing comments.

WIFI_SSID=YOUR_SSID
WIFI_PASS=YOUR_PASS

# POSIX TZ string. The bridge owns timezone and DST — the device is told local
# time already adjusted and never reasons about zones.
#
# Mind the sign: POSIX offsets are inverted, so UTC+10 is written -10. Check a
# candidate against tzdata across a whole year before trusting it, or the clock
# will be an hour out for part of it.
#   AEST-10AEDT,M10.1.0,M4.1.0/3   Melbourne / Sydney
#   GMT0BST,M3.5.0/1,M10.5.0       UK
#   PST8PDT,M3.2.0,M11.1.0         US Pacific
TZ_POSIX=AEST-10AEDT,M10.1.0,M4.1.0/3

# NTP server.
NTP1=pool.ntp.org

# Over-the-air updates. The bridge advertises itself as <OTA_HOST>.local, so
# `pio run -e atoms3u_ota -t upload` reflashes it over Wi-Fi with no cable.
# OTA_PASS guards that: anyone on the network can otherwise push firmware.
# Generate one with:  python3 -c "import secrets,string;print(''.join(
#   secrets.choice(string.ascii_letters+string.digits) for _ in range(20)))"
OTA_HOST=scope-clock-bridge
OTA_PASS=CHANGE_ME

# MQTT broker for Home Assistant. The clock announces itself over MQTT
# discovery, so it appears in HA as a device with a face selector, a brightness
# control and a notify target — no YAML needed. Leave MQTT_HOST empty to run
# without a broker; everything else still works.
MQTT_HOST=192.168.1.10
MQTT_PORT=1883
MQTT_USER=
MQTT_PASS=
MQTT_PREFIX=scopeclock

# Set to 0 to drop the password prompt on the config page. LAN-only convenience:
# anyone who can reach the bridge can then control the clock. OTA flashing still
# uses OTA_PASS either way.
WEB_AUTH=1
